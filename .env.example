# Public origin used for payment redirects and webhook hints.
APP_URL="http://localhost:3000"

# SQLite (default, zero-config). In Docker the compose file sets file:/data/openstore.db.
DATABASE_URL="file:./dev.db"

# Required: signs sessions and payment cancel tokens. Use 32+ random bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# PostgreSQL (optional; also change the Prisma datasource provider to "postgresql")
# DATABASE_URL="postgresql://openstore:password@localhost:5432/openstore?schema=public"
